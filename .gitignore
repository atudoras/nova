# --- RStudio / R session state (per-machine, never commit) ---
.Rproj.user
.Rhistory
.Ruserdata
*.RData
Rplots.pdf
inst/doc

# --- agent / worktree tooling (kept local) ---
.claude/worktrees/
.claire/

# --- case studies ---
# Downloaded datasets are never committed: they are large and they belong to
# whoever published them. Each study's SOURCE.md records how to fetch them.
case_studies/**/data/
# The discovery pass is an uncurated dump, regenerated by rerunning the engine.
# The rendered HTML/PDF summaries ARE committed -- they are the portfolio.
case_studies/**/outputs/
case_studies/renv/library/
case_studies/renv/staging/
case_studies/**/*_files/

# --- macOS ---
.DS_Store

# --- session / agent scratch (never public) ---
*_SESSION_PROMPT.md
NEXT_SESSION*.md
CRAN-SUBMISSION
